/* vim: ft=css
 */
ProjectInfo {
    height: 1;
    width: 1fr;
    dock: top;
}

ProjectInfo #projectName {
    width: 1fr;
}

BuildDisplay {
    width: 1fr;
    height: 1fr;
}

BuildDisplay #build_tree {
    /* padding: 1 1 1 1; */
    height: auto;
    border: round grey;
    border-title-align: right;
}

BuildDisplay #build_tree :focus {
    /* padding: 1 1 1 1; */
    border: round orange;
    background: black;
}

BuildDisplay #console {
    height: 1fr;
}

BuildDisplay #console RichLog {
    border-title-align: right;
    border: round grey;
    height: 1fr;
}

BuildDisplay #console RichLog :focus {
    border: round orange;
    height: 1fr;
}
