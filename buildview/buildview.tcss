ProjectInfo {
    height: 3;
    width: 1fr;
    dock: top;
    border: solid white;
}

ProjectInfo #projectName {
    width: 1fr;
}

BuildDisplay #step_log {
    border: solid grey;
    height: 2fr;
    width: 1fr;
    display: none;
    # overflow-x: hidden;
}

BuildDisplay #step_log:focus {
    border: solid white;
}

BuildDisplay #build_tree {
    padding: 1 1 1 1;
    height: auto;
}
